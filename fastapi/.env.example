# Copy to .env; excluded from version control.
# Local: SQLite. Supabase: Project Settings > Database > Connection string (URI).
DATABASE_URL=sqlite:///./willow.db
# Random secret (32+ chars). Set the same value in Vapi's Server URL secret
# (sent as X-Vapi-Secret) or as a Bearer credential. Empty = webhook returns 503.
WEBHOOK_SECRET=
# Required as the X-Api-Key header on GET /api/*. Empty = those endpoints return 503.
API_KEY=
# Vapi private API key (server-side only). Used to fetch a finished call when the
# webhook arrives without structured outputs. Empty = no fetch.
VAPI_API_KEY=
VAPI_RETRY_DELAYS=2,4,8,16
# Comma-separated; the first is the app link in results emails.
FRONTEND_ORIGIN=https://willow-ai.vercel.app,http://localhost:5173
PROGRAMS_PATH=fixtures/programs.json

RESEND_API_KEY=
# Without your own verified domain use onboarding@resend.dev (only reaches your Resend account email).
FARMBRIDGE_FROM_EMAIL=
EMAIL_DELIVERY_ENABLED=false
FARMBRIDGE_REPLY_TO=
# Testing only: send every results email here instead of the address heard on the call
EMAIL_OVERRIDE_TO=

# Results SMS. Enable only after a Twilio sender and account are configured.
SMS_DELIVERY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS origin serving /report/<token>, e.g. your backend ngrok URL.
REPORT_BASE_URL=
