# Copy to .env; excluded from version control.
# Local: SQLite. Supabase: Project Settings > Database > Connection string (URI).
DATABASE_URL=sqlite:///./willow.db
# Random secret (32+ chars). Set the same value in Vapi as the server secret
# (sent as X-Vapi-Secret) or as a Bearer token credential. Empty = webhook returns 503.
WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
PROGRAMS_PATH=fixtures/programs.json
