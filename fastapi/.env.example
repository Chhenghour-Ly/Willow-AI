# Copy to .env; excluded from version control. Do not use real farmer data locally.
DATABASE_URL=sqlite:///./cases.db
# Live Vapi ingestion remains blocked pending a real payload and auth review.
DEMO_MODE=true
# Generate a random secret (32+ bytes); configure the same Bearer credential in Vapi.
# Empty value fails closed with 503. Never use a Vapi API key here.
WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
# No query string or fragment; use HTTPS for real SMS.
REVIEW_BASE_URL=http://localhost:3000/review
REVIEW_TTL=3600
SESSION_TTL=3600
# Default providers simulate acceptance; they send nothing.
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
# Both twilio and this switch are required for a real smoke test.
REAL_SMS_ENABLED=false
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Comma-separated exact addresses. Applies to ALL email, including non-demo mode.
TEST_RECIPIENTS=damage-demo@example.test
DEFAULT_RECIPIENT=damage-demo@example.test
# SMTP uses required STARTTLS and a 20-second socket timeout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Must exceed maximum adapter execution time; interrupted sends become uncertain.
JOB_LEASE_SECONDS=300
